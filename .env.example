# Salin file ini jadi .env.local lalu isi nilainya.
# Cara dapetin Client ID & Secret ada di README.md bagian "Setup Google Cloud".

GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx

# OPSIONAL. Kalau kosong, URL diambil otomatis dari domain yang sedang dibuka
# (localhost waktu dev, domain asli waktu deploy). Isi hanya kalau mau memaksa satu domain.
# Redirect URI yang didaftarkan di Google Cloud harus: {URL aplikasi}/api/auth/callback
# APP_URL=https://domainkamu.com
